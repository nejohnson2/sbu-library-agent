# Which model connection to use: ollama (local) or litellm (remote gateway)
LLM=ollama

# Local Ollama on this machine
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4

# Remote LiteLLM gateway (only needed when LLM=litellm)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# SBU NEXUS MCP server (leave blank to run without it)
NEXUS_MCP_URL=

# Hide pydantic-ai startup banner
PYDANTIC_AI_NO_BANNER=1
